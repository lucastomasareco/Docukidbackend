# Copia este archivo como ".env" (sin el ".example") y completa los valores reales.
# El archivo ".env" NUNCA se sube a ningún repositorio ni se comparte.
# El backend valida todas las variables REQUIRED al arrancar usando Pydantic
# BaseSettings (app/config.py): si falta cualquiera, falla rápido listando
# TODAS las faltantes a la vez, no solo la primera.

# =====================================================================
# REQUIRED — obligatorias. El servidor NO ARRANCA si falta alguna
# o si viene vacía (app/config.py exige min_length=1).
# =====================================================================

# --- Supabase (base de datos) ---
# Cadena de conexión PostgreSQL. La encontrás en tu proyecto de Supabase >
# Project Settings > Database > Connection string (modo "URI").
# Ojo: aquí va la que empieza "postgresql://"; el backend la adapta solo
# a "postgresql+asyncpg://".
# REQUERIDA.
DATABASE_URL=postgresql://<usuario>:<password>@<host>:<puerto>/<db>

# --- Supabase (validación de JWT por JWKS) ---
# Endpoint público de claves públicas de Supabase Auth, usado para verificar
# la firma de los tokens que envía el frontend. NO es un secreto: es una
# URL de .well-known que Supabase publica.
# Formato: https://<TU-PROYECTO>.supabase.co/auth/v1/.well-known/jwks.json
# La encontrás en Project Settings > API > General > Project URL
# (armás la URL pegándole "/auth/v1/.well-known/jwks.json" al final).
# REQUERIDA.
SUPABASE_JWKS_URL=https://<tu-proyecto>.supabase.co/auth/v1/.well-known/jwks.json

# --- Firma del "state" en OAuth de Google ---
# Clave independiente para firmar el parámetro "state" del flujo OAuth de
# Google. Evita que un atacante pueda falsificar a qué usuario pertenece
# un refresh_token cuando Google vuelve del callback.
# Generala con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUERIDA. No puede quedar vacía. No hay fallback a SUPABASE_JWT_SECRET
# (esa variable ya no existe: auth usa JWKS) ni a ningún otro secreto.
STATE_SECRET=<generá-con-python-c-secrets.token_urlsafe-48>

# --- Scheduler (cron-job.org) ---
# Secreto compartido entre cron-job.org y el endpoint /scheduler/check.
# cron-job.org lo envía en la cabecera HTTP "X-Cron-Secret" y el backend
# lo compara contra este valor. Si no coincide, responde 401 y no hace nada.
# Generala con el mismo comando que STATE_SECRET.
# REQUERIDA.
CRON_SECRET=<tu-cron-secret>

# --- Google Cloud Console (cliente OAuth 2.0 tipo "Aplicación web") ---
# Los tres salen del cliente OAuth que creaste en Google Cloud Console.
# GOOGLE_REDIRECT_URI debe ser EXACTAMENTE igual (carácter por carácter)
# a la que registraste ahí, algo como:
#   https://tu-backend.onrender.com/auth/google/callback
# o, en local:
#   http://localhost:8000/auth/google/callback
# REQUERIDAS.
GOOGLE_CLIENT_ID=<tu-client-id>
GOOGLE_CLIENT_SECRET=<tu-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Google AI Studio (Gemini / OCR) ---
# API key para usar Gemini y extraer la fecha de vencimiento de los
# documentos. La generás en ai.google.dev (NO en Google Cloud Console).
# REQUERIDA.
GEMINI_API_KEY=<tu-api-key>

# =====================================================================
# OPTIONAL — opcionales (campos de app/config.py con default).
# Si las OMITÍS del .env, el backend usa el default. No las dejes vacías:
# un string vacío pisa el default.
# =====================================================================

# A dónde redirigimos al usuario después del callback de Google (tanto
# si salió todo bien como si hubo un error). Normalmente es el "deep link"
# de la app móvil de Expo (revisá el "scheme" en app.json).
# OPCIONAL. Default: docukids://
FRONTEND_URL=docukids://

# Entorno de ejecución. Solo afecta SI registramos el endpoint
# /auth/google/url-dev (sin autenticación, SOLO para desarrollar).
# Valores: "development" → registra la ruta dev. Cualquier otro valor
# (incluyendo dejarla en el default) → NO la registra.
# OPCIONAL. Default: production
ENV=production

# Modelo de Gemini para el OCR. Los únicos gratuitos verificados (sept.
# 2026) son gemini-2.0-flash-lite y gemini-flash. NO cambiar a modelos
# "Pro": dejaron de ser gratuitos y se cobran sin avisar.
# OPCIONAL. Default: gemini-2.0-flash-lite
GEMINI_MODEL=gemini-2.0-flash-lite

# Cuántos días antes de un vencimiento empieza a enviar el aviso por
# correo. Por ejemplo, 15 → avisa a partir de 15 días antes de la fecha.
# OPCIONAL. Default: 15
NOTIFICATION_THRESHOLD_DAYS=15

# Zona horaria usada para TODOS los cálculos de "hoy" en el backend
# (estado de documentos, scheduler, marcado de notificaciones, etc.).
# OPCIONAL. Default: America/Argentina/Buenos_Aires
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Zona horaria usada ESPECÍFICAMENTE para los eventos de Google Calendar
# creados por el endpoint /appointments. Puede ser igual a APP_TIMEZONE
# o distinto si el proyecto escala a usuarios en otro país.
# OPCIONAL. Default: America/Argentina/Buenos_Aires
APPOINTMENT_TIMEZONE=America/Argentina/Buenos_Aires

# =====================================================================
# OBSOLETAS — el backend las IGNORA si aparecen en el .env
# =====================================================================
# SUPABASE_JWT_SECRET  → ya no se usa. La auth pasó de HS256 (secreto
# compartido) a JWKS (SUPABASE_JWKS_URL). No la copies ni la setees.

# =====================================================================
# NO las lee el backend (config.py las ignora: extra="ignore")
# =====================================================================

# --- Solo FRONTEND (la app móvil las usa con @supabase/supabase-js) ---
# Project Settings > API. El frontend las necesita para Auth; el backend
# NO las lee.
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<tu-publishable-key>

# Secret key de Supabase (reemplaza a service_role). El backend actual NO la usa.
# Dejala solo si en el futuro vas a llamar a la Admin API de Supabase desde el backend.
SUPABASE_SECRET_KEY=<tu-secret-key>
